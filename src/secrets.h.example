# secrets.h — NO LONGER USED (v6+)
#
# Credentials are never compiled into the firmware. They are provisioned at
# runtime via the Birdy-Setup captive portal and stored in /config.json on
# LittleFS (WiFi SSID/password, API URL/key/birdy-id). See BirdyConfig /
# BirdySetup and the v9 PCB README.
#
# This file is kept only so older checkouts with a real secrets.h do not
# break the build: nothing includes it anymore.
